{
  "name": "rekordo-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "start:staging": "EXPO_PUBLIC_API_BASE=https://staging.rekordo.de expo start",
    "start:prod": "EXPO_PUBLIC_API_BASE=https://rekordo.de expo start",
    "dev:staging": "EXPO_PUBLIC_API_BASE=https://staging.rekordo.de expo start --dev-client",
    "dev:prod": "EXPO_PUBLIC_API_BASE=https://rekordo.de expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src"
  },
  "dependencies": {
    "@janne6565/rekordo-shared": "0.34.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-device": "^57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "^57.0.15",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "i18next": "^24.2.0",
    "lucide-react-native": "^0.469.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.4.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "trustedDependencies": ["@biomejs/biome"]
